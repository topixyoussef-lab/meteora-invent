# ---------------------------------------------------------------------------
# Solana cluster + RPC
# ---------------------------------------------------------------------------
# 'devnet' or 'mainnet-beta'. Defaults to 'devnet' when unset or unrecognised.
# The launchpad is a Devnet PoC: keep this on 'devnet' until you are ready.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional public RPC override. Leave blank to use the public endpoint for the
# selected cluster (api.devnet.solana.com / api.mainnet-beta.solana.com).
# This variable is inlined into the browser bundle, so NEVER put a secret or a
# paid-API key here -- use a rate-limited public URL or proxy through a server.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Cloudflare R2 Storage (server-side only, never exposed to the browser)
# ---------------------------------------------------------------------------
# Token metadata JSON is uploaded to R2 before launch. See README for the
# expected bucket layout and CORS requirement.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=your_r2_bucket_name

# ---------------------------------------------------------------------------
# Server-side Solana RPC (optional)
# ---------------------------------------------------------------------------
# Not used by scripts/verify-presets.ts -- that script is fully offline and never
# opens a connection. Set this only if you later add a server-side script that
# needs an RPC. A private key is safe here because this file is never bundled.
# RPC_URL=your_rpc_url

# ---------------------------------------------------------------------------
# Existing pool config (optional)
# ---------------------------------------------------------------------------
# Pre-registers a bonding-curve config PDA so launches can target an existing
# config instead of creating a new one. Leave blank to create config on launch.
POOL_CONFIG_KEY=your_pool_config_key
